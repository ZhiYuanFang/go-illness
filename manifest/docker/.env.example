# =============================================================================
# Docker Compose 环境变量模板（占位符，不含真实密钥）
# 复制到 manifest/docker/env/ 下使用，例如：
#   manifest/docker/env/.env.local
#   manifest/docker/env/.env.test
#   manifest/docker/env/.env.prod
# 目录 manifest/docker/env/ 已整目录 gitignore，勿将真实密钥提交入库。
# =============================================================================
#
# GitHub Actions → 阿里云 ACR 凭证（不读本文件，须在 GitHub 配置）：
#   Repository secrets: ACR_USERNAME, ACR_PASSWORD
#   Environment test / prod: REGISTRY（服务器 pull 地址，可用 -vpc 域名；
#     CI 会自动去掉 -vpc 推导公网 push 地址）
# 触发：git tag v0.0.1 && git push origin v0.0.1
#   → 纯 vMAJOR.MINOR.PATCH → Environment prod
#   → 含 -rc/-beta 等预发布后缀 → Environment test
# 手动：Actions → docker-acr → Run workflow
# =============================================================================

# --- 镜像（test/prod 部署）---
REGISTRY=crpi-xxx.cn-hangzhou.personal.cr.aliyuncs.com/your-namespace
IMAGE_TAG=v0.0.1

# --- MySQL（同 go_ai_talk 实例、独立库 illness）---
MYSQL_TCP_HOST=mysql-host-ip
ILLNESS_DB_LINK=mysql:user:password@tcp(mysql-host:3306)/illness

# --- OSS（与 go_ai_talk 同桶同 CDN；前缀 illness/；上传接口改造另开 change）---
ILLNESS_OSS_ACCESS_KEY_ID=
ILLNESS_OSS_ACCESS_KEY_SECRET=
# 可选：本地非 VPC 覆盖公网 endpoint
# ILLNESS_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# --- 日志（可选）---
# GF_LOGGER_LEVEL=prod
